# Local development signs in as seedy@sites.test through the bundled loopback-only mock.
# On hosted Sites, set ADMIN_EMAIL to the owner's actual ChatGPT email.
ADMIN_EMAIL=
# Netlify owner access: username dino404found; SHA-256 of a random 32+ character secret.
# Leave unset to deny all owner access. Never put the secret or hash in public code.
ADMIN_PASSWORD_SHA256=
# Netlify's public URL, including https:// (no path). Set for a stable preview alias.
APP_ORIGIN=
REWARDS_ENABLED=false
REWARD_CONTRACT=
REWARD_FIRST=
REWARD_SECOND=
REWARD_THIRD=
REWARD_SCHEDULE=
